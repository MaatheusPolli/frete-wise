PORT=3000
LOG_LEVEL=info
PROVIDER_TIMEOUT_MS=3000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_MS=30000
CACHE_TTL_MS=300000
# REDIS_URL=redis://localhost:6379
CEP_API_URL=https://viacep.com.br/ws
# Provedor HTTP opcional (desabilitado se vazio)
# EXPRESSO_API_URL=http://localhost:4000
FREE_SHIPPING_THRESHOLD_CENTS=50000
TRACKING_DAY_MS=86400000

# Banco de dados
# Sem DATABASE_URL a API usa Postgres embutido (PGlite) persistido em PGLITE_DATA_DIR.
# DATABASE_URL=postgres://fretewise:<senha>@localhost:5432/fretewise
PGLITE_DATA_DIR=./data/pgdata
# Usado pelo docker-compose (defina uma senha forte no seu .env, nunca versionado)
POSTGRES_USER=fretewise
POSTGRES_PASSWORD=
POSTGRES_DB=fretewise
